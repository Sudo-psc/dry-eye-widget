---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import { author, blogArticles, content, references, type Lang } from '../content/siteData';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = content[lang];
const article = blogArticles[lang].find((item) => item.slug === slug);

if (!article) {
  throw new Error(`Article not found: ${lang}/${slug}`);
}

const homeHref = `/app/${lang}/`;
const blogHref = `/app/${lang}/blog/`;
const paragraphs = (t.articleContent as Record<string, string[]>)[slug] ?? [];
const canonical = `https://olhossecos.com.br${blogHref}${slug}/`;
const alternateSlug = lang === 'pt'
  ? slug === 'regra-20-20-20' ? '20-20-20-rule' : 'dry-eye-screens'
  : slug === '20-20-20-rule' ? 'regra-20-20-20' : 'olho-seco-telas';
const alternate = `https://olhossecos.com.br/app/${lang === 'pt' ? 'en' : 'pt'}/blog/${alternateSlug}/`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  datePublished: article.date,
  author: {
    '@type': 'Person',
    name: 'Dr. Philipe Saraiva Cruz',
    jobTitle: lang === 'pt' ? 'Médico Oftalmologista' : 'Ophthalmologist'
  },
  publisher: {
    '@type': 'Organization',
    name: 'Dry Eye Widget'
  },
  mainEntityOfPage: canonical
};
---
<BaseLayout lang={lang} htmlLang={t.htmlLang} title={`${article.title} - Dry Eye Widget`} description={article.description} canonical={canonical} alternate={alternate}>
  <Header nav={t.nav} langLabel={t.langLabel} langHref={`/app/${lang === 'pt' ? 'en' : 'pt'}/blog/${alternateSlug}/`} themeLabel={t.themeLabel} blogHref={blogHref} homeHref={homeHref} />
  <main class="page-main">
    <article class="article-layout">
      <header class="article-header">
        <a class="back-link" href={blogHref}>← {t.sections.blogTitle}</a>
        <p class="section-kicker">{article.date} · {article.readTime}</p>
        <h1>{article.title}</h1>
        <p>{article.description}</p>
        <div class="byline">
          <img src="/assets/dr-philipe.jpg" alt={lang === 'pt' ? 'Foto do Dr. Philipe Saraiva Cruz' : 'Photo of Dr. Philipe Saraiva Cruz'} width="44" height="44" />
          <span>{author[lang]} · {author.credentials}</span>
        </div>
      </header>
      <div class="article-body">
        {paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
        <aside class="medical-note">
          <strong>{lang === 'pt' ? 'Nota médica' : 'Medical note'}</strong>
          <p>{t.sections.authorityBody}</p>
        </aside>
        <h2>{t.sections.referencesTitle}</h2>
        <ol class="references compact-references">
          {references.slice(0, 4).map((reference) => (
            <li>
              <strong>{reference.title}</strong>
              <span>{reference.journal}</span>
              <a href={reference.url}>doi:{reference.doi}</a>
            </li>
          ))}
        </ol>
      </div>
    </article>
  </main>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</BaseLayout>
