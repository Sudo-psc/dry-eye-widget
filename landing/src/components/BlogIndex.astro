---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import { blogArticles, content, type Lang } from '../content/siteData';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const homeHref = `/app/${lang}/`;
const blogHref = `/app/${lang}/blog/`;
const title = `${t.sections.blogTitle} - Dry Eye Widget`;
const description = t.sections.blogSubtitle;
---
<BaseLayout lang={lang} htmlLang={t.htmlLang} title={title} description={description} canonical={`https://olhossecos.com.br${blogHref}`} alternate={`https://olhossecos.com.br/app/${lang === 'pt' ? 'en' : 'pt'}/blog/`}>
  <Header nav={t.nav} langLabel={t.langLabel} langHref={t.langHref.replace(/\/$/, '/blog/')} themeLabel={t.themeLabel} blogHref={blogHref} homeHref={homeHref} />
  <main class="page-main">
    <section class="page-hero">
      <p class="section-kicker">{t.nav.blog}</p>
      <h1>{t.sections.blogTitle}</h1>
      <p>{t.sections.blogSubtitle}</p>
    </section>
    <section class="section">
      <div class="article-grid">
        {blogArticles[lang].map((article) => (
          <a class="article-card" href={`${blogHref}${article.slug}/`}>
            <span>{article.date} · {article.readTime}</span>
            <strong>{article.title}</strong>
            <p>{article.description}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

