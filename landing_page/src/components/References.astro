---
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="science" class="py-20 relative bg-surface/30 border-t border-white/5">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold">{t('science.title')}</h2>
      <div class="w-16 h-1 bg-primary mx-auto mt-4 rounded-full opacity-80"></div>
    </div>
    
    <div class="grid gap-6 md:grid-cols-2">
      <!-- Ref 1 -->
      <div class="glass-panel p-6 rounded-xl hover:-translate-y-1 transition-transform">
        <svg class="w-8 h-8 text-primary mb-4 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <p class="text-sm opacity-90 leading-relaxed font-medium">
          {t('science.ref1')}
        </p>
      </div>

      <!-- Ref 2 -->
      <div class="glass-panel p-6 rounded-xl hover:-translate-y-1 transition-transform">
        <svg class="w-8 h-8 text-primary mb-4 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        <p class="text-sm opacity-90 leading-relaxed font-medium">
          {t('science.ref2')}
        </p>
      </div>

      <!-- Ref 3 -->
      <div class="glass-panel p-6 rounded-xl hover:-translate-y-1 transition-transform md:col-span-2 md:w-1/2 md:mx-auto">
        <svg class="w-8 h-8 text-primary mb-4 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <p class="text-sm opacity-90 leading-relaxed font-medium">
          {t('science.ref3')}
        </p>
      </div>
    </div>
  </div>
</section>
