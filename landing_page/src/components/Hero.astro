---
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden flex items-center justify-center min-h-[90vh]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center animate-slide-up">
    <!-- Badge -->
    <div class="inline-flex items-center px-3 py-1 rounded-full glass-panel text-sm font-medium mb-8">
      <span class="flex h-2 w-2 rounded-full bg-primary mr-2"></span>
      Ophthalmologist Designed
    </div>

    <!-- Typography -->
    <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 bg-clip-text text-transparent bg-gradient-to-r from-primary to-blue-400">
      {t('hero.title')}
    </h1>
    <p class="mt-4 text-xl md:text-2xl opacity-80 max-w-3xl mx-auto mb-10 leading-relaxed">
      {t('hero.subtitle')}
    </p>

    <!-- Download Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#" class="glass-button px-8 py-4 rounded-xl flex items-center gap-3 w-full sm:w-auto font-semibold text-lg hover:shadow-lg hover:shadow-primary/20 transition-all transform hover:-translate-y-1">
        <!-- Apple Icon -->
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.08zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
        </svg>
        {t('hero.downloadMac')}
      </a>
      
      <a href="#" class="glass-button px-8 py-4 rounded-xl flex items-center gap-3 w-full sm:w-auto font-semibold text-lg hover:shadow-lg hover:shadow-primary/20 transition-all transform hover:-translate-y-1">
        <!-- Windows Icon -->
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.951-1.801"/>
        </svg>
        {t('hero.downloadWin')}
      </a>
    </div>

    <!-- Floating UI element decorative -->
    <div class="mt-20 relative mx-auto w-full max-w-5xl">
      <div class="absolute inset-0 bg-gradient-to-t from-background to-transparent z-20 h-full w-full"></div>
      <div class="glass-panel rounded-2xl p-2 md:p-4 border border-white/20 shadow-2xl overflow-hidden relative">
        <div class="bg-surface/50 rounded-xl w-full aspect-video flex items-center justify-center overflow-hidden">
          <!-- Placeholder for Hero Image / App screenshot -->
          <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-blue-500/5"></div>
          <svg class="w-24 h-24 text-primary/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
