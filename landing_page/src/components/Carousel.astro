---
interface Props {
  lang: 'pt' | 'en';
}

const { lang } = Astro.props;
---

<section class="py-12 overflow-hidden relative">
  <!-- Faded edges for carousel -->
  <div class="absolute left-0 top-0 bottom-0 w-32 bg-gradient-to-r from-background to-transparent z-10 pointer-events-none"></div>
  <div class="absolute right-0 top-0 bottom-0 w-32 bg-gradient-to-l from-background to-transparent z-10 pointer-events-none"></div>

  <div class="flex gap-8 overflow-x-auto pb-8 snap-x snap-mandatory hide-scrollbar px-[10vw]">
    <!-- Placeholder images for UI screenshots -->
    {[1, 2, 3].map((i) => (
      <div class="snap-center shrink-0 w-[80vw] md:w-[600px] aspect-[16/10] glass-panel rounded-2xl overflow-hidden shadow-2xl border border-white/20 transform transition-transform duration-500 hover:scale-[1.02]">
        <div class="w-full h-full bg-gradient-to-br from-surface to-primary/10 flex flex-col items-center justify-center p-8 text-center">
           <svg class="w-16 h-16 text-primary/30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
           <span class="text-sm font-medium opacity-50">UI Screenshot {i}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
